from fastapi import FastAPI, WebSocket, WebSocketDisconnect, Request, requests
from fastapi.templating import Jinja2Templates
from fastapi.staticfiles import StaticFiles

app = FastAPI()
templates = Jinja2Templates(directory="src/chat")

app.mount(path="/static", app=StaticFiles(directory="src/chat/static"), name="static")


@app.get("/", name="main_page")
def main_page(request: Request):
    return templates.TemplateResponse(request, name="index.html")
